{
    "name": "poc-signature/pki-sdk-php",
    "description": "Framework-agnostic PHP SDK for interacting with the Trust API (sign, verify, proofs)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "PkiSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PkiSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
