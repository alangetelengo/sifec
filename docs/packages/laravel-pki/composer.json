{
    "name": "poc-signature/laravel-pki",
    "description": "Laravel package providing PKI signature services via the pki-sdk-php",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "poc-signature/pki-sdk-php": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../pki-sdk-php",
            "options": {
                "symlink": true,
                "versions": {
                    "poc-signature/pki-sdk-php": "0.1.0"
                }
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "LaravelPki\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPki\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPki\\PkiServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
