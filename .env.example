    # PROCEDURE AJOUT DES FONCTIONNALITES A premier USER

    $user = User::find("USR_00000004");

    //choisir les fonctionnalites à lui assigner
    $fs = Fonctionnalite::whereIn("code_fonctionnalite",["FNC_0030","FNC_0031"])->get();
    //verifier la liste des ses fonctionnalites
    $user->toutesfonctionnalites()->pluck("code_fonctionnalite");

    //assigner les fonctionnalites
    $user->fonctionnalites()->sync($fs);
    //verifier la nouvelle liste de ses fonctionnalites
    $user->toutesfonctionnalites()->pluck("code_fonctionnalite")

    # FIN DE PROCEDURE AJOUT DES FONCTIONNALITES A premier USER


