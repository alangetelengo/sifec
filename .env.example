//nbre de naissance par departement.
DB::select("SELECT copremiert(an.niupp) as nbre_naissance,locP.lib_localite FROM t_acte_naissance an JOIN tr_ins_user iu ON iu.cui = an.cui JOIN tr_institution cec ON cec.code_institution = iu.code_institution JOIN tr_institution cecp ON cecp.code_institution = cec.code_institution_parent JOIN tr_localite loc ON loc.code_localite = cecp.code_localite  JOIN tr_localite locP ON locP.code_localite = loc.code_localite_parent where locP.code_localite = ? GROUP BY an.niupp,locP.lib_localite",["LOC_0001"]);


