# LA COMPOSITION DU NIUPP
use Modules\Naissance\Entities\ActeNaissance;
use Carbon\Carbon;
$an = ActeNaissance::find("AN_00000001");
$sexe = $an->declaration->enfant->sexe;
$anneeNais = new Carbon($an->declaration->enfant->date_naissance);
$annee = $anneeNais->year;
$mois = $anneeNais->format('m');
$dept = substr($an->institutionUser->institution->departement()->lib_departement, 0,4) ;
$comDist = substr($an->institutionUser->institution->subDepartement(), 0,3);

$numOrdre = Sifec::genererCodeUniqueReferentiel(new ActeNaissance,"niupp",3,"");

$niupp = $sexe.$annee.$mois.$dept.$comDist.$numOrdre;



